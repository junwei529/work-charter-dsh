{
  "name": "work-charter-dsh",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "DSH-native Work Charter policy plugin backed by session-coordinator-dsh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junwei529/work-charter-dsh.git"
  },
  "homepage": "https://github.com/junwei529/work-charter-dsh#readme",
  "bugs": {
    "url": "https://github.com/junwei529/work-charter-dsh/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "assets/work-charter-dsh.md",
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/types.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -b tsconfig.host.json && node scripts/generate-typert.mjs && tsdown --env.DSH_BUILD_FACE host && tsc -b tsconfig.client.json && tsdown --env.DSH_BUILD_FACE client && node scripts/release-audit.mjs normalize-source-maps",
    "typecheck": "tsc -b tsconfig.host.json tsconfig.client.json && tsc -p tsconfig.test.json --pretty false",
    "lint": "eslint src tests tsdown.config.ts vitest.config.ts",
    "test": "npm run build && vitest run",
    "test:unit": "npm run build && vitest run tests/unit",
    "release:audit": "node scripts/release-audit.mjs audit-current",
    "release:reproduce": "node scripts/release-audit.mjs reproduce",
    "pack:check": "node scripts/release-audit.mjs pack-current",
    "verify:dsh-source": "node scripts/verify-dsh-alpha-source.mjs"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-skill": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.1",
    "react": "18.3.1",
    "session-coordinator-dsh": "0.1.1-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-skill": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-typert-generator": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "eslint": "10.8.1",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "session-coordinator-dsh": "0.1.1-alpha.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.8"
  }
}
